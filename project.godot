; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lantern"
config/description="Alone on a station-ship at Saturn and beyond. Keep it alive."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Sfx="*res://scripts/sfx.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/default_gravity=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.02

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3

[editor]

movie_writer/mjpeg_quality=0.92
movie_writer/mix_rate=48000
